<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">
    <TextView
        android:id="@+id/notification_item_marker"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="#16834A"
        android:textSize="11sp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/notification_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pending confirmation"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/notification_item_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="A station update needs your attention."
            android:textColor="#64748B"
            android:textSize="10sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
